# Copy this file to .env (the launchers do it for you), or paste keys in the app under
# Sources & keys -> API keys & connectors. Everything is optional.

# ---- AI (briefings, ideas, Ask the desk, memory upkeep) -------------------------------
ANTHROPIC_API_KEY=            # https://console.anthropic.com/settings/keys

# ---- Prices ----------------------------------------------------------------------------
TWELVEDATA_API_KEY=           # https://twelvedata.com/register  (free: 800 calls/day)

# ---- News APIs (each one is a new source the news model learns from) -------------------
ALPACA_API_KEY_ID=            # https://app.alpaca.markets/signup  free paper account = Benzinga newswire
ALPACA_API_SECRET=
FINNHUB_API_KEY=              # https://finnhub.io/register  (also stock quotes if Twelve Data is missing)
POLYGON_API_KEY=              # https://polygon.io/dashboard/signup  (news + sentiment, 5-minute bars fallback)
FMP_API_KEY=                  # https://site.financialmodelingprep.com/developer/docs
MARKETAUX_API_KEY=            # https://www.marketaux.com/register
TIINGO_API_KEY=               # https://www.tiingo.com/account/api/token
NEWSAPI_API_KEY=              # https://newsapi.org/register
BENZINGA_API_KEY=             # https://www.benzinga.com/apis/  (paid; skip if you use Alpaca)
ALPHAVANTAGE_API_KEY=         # https://www.alphavantage.co/support/#api-key  (free: 25 calls/day)

# ---- Search ----------------------------------------------------------------------------
TAVILY_API_KEY=               # https://app.tavily.com
FIRECRAWL_API_KEY=            # https://www.firecrawl.dev  (only when a site blocks direct fetches)

# ---- MCP connectors (remote servers) ---------------------------------------------------
COINMARKETCAP_API_KEY=        # https://coinmarketcap.com/api/
# COINMARKETCAP_MCP_URL=https://mcp.coinmarketcap.com/mcp
BIGDATA_API_KEY=              # https://bigdata.com
# BIGDATA_MCP_URL=https://mcp.bigdata.com/

# ---- Settings --------------------------------------------------------------------------
# PORT=8787                   # the app runs at http://localhost:8787
# TAPEWIRE_PROMPT_KB=160      # how much of the library each AI request may read (KB)
