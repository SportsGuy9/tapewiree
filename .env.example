# Copy this file to .env and fill in what you have. Everything is optional.

# AI features (briefings, idea generation, Ask the desk, memory upkeep). https://console.anthropic.com
ANTHROPIC_API_KEY=

# Free market-data keys. Without them those sources show "needs key" and the rest keeps working.
TWELVEDATA_API_KEY=          # https://twelvedata.com (stock & ETF quotes, QQQ 5-minute bars for P&L marks)
ALPHAVANTAGE_API_KEY=        # https://www.alphavantage.co (news with sentiment)
TAVILY_API_KEY=              # https://tavily.com (optional extra news search)
FIRECRAWL_API_KEY=           # optional: only used when a site blocks a direct fetch

# PORT=8787                  # the address is http://localhost:8787
# TAPEWIRE_PROMPT_KB=160     # how much of the library each AI request may read (KB). Higher = deeper and pricier.
